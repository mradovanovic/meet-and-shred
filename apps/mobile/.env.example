# Variables d'environnement de l'app mobile (Expo).
# Copie ce fichier en .env.local et remplis les valeurs (le wizard le fait pour toi :
# `bash scripts/setup-supabase.sh`). .env.local est gitignoré — ne commit jamais les vraies clés.
#
# Clés Supabase — Project Settings → API.
# La clé "anon public" est faite pour le client (protégée par les politiques RLS).
# NE JAMAIS mettre la clé "service_role" ici : elle contourne RLS.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Token public Mapbox (commence par pk.) — Account → Tokens → Default public token.
EXPO_PUBLIC_MAPBOX_TOKEN=pk....
